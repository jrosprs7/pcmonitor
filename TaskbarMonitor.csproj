<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskbarMonitor</AssemblyName>
    <RootNamespace>TaskbarMonitor</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Equivalent to <UseWindowsForms>true</UseWindowsForms>, but also builds on non-Windows SDKs. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <Using Include="System.Drawing" />
    <Using Include="System.Windows.Forms" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
